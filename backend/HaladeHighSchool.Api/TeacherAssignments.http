@baseUrl = http://localhost:5006
@token = replace-with-an-admin-access-token
@teacherId = 1

### Get a teacher's grade and section assignments
GET {{baseUrl}}/api/admin/teachers/{{teacherId}}/assignments
Authorization: Bearer {{token}}

### Assign one or more sections to a teacher
POST {{baseUrl}}/api/admin/teachers/{{teacherId}}/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assignments": [
    { "gradeLevelId": 1, "sectionId": 1 },
    { "gradeLevelId": 1, "sectionId": 2 }
  ]
}

### Replace all section assignments for a teacher
PUT {{baseUrl}}/api/admin/teachers/{{teacherId}}/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assignments": [
    { "gradeLevelId": 2, "sectionId": 1 }
  ]
}

### Remove a teacher from a section
DELETE {{baseUrl}}/api/admin/teachers/{{teacherId}}/assignments/1
Authorization: Bearer {{token}}
