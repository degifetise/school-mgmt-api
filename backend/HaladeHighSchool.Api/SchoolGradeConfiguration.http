@baseUrl = http://localhost:5006
@accessToken = replace-with-admin-access-token

### Load this administrator's school-specific grade and section settings
GET {{baseUrl}}/api/admin/grade-configuration
Authorization: Bearer {{accessToken}}

### Replace grade availability and section assignments
### Replace grade IDs/section IDs with the IDs returned by the GET request.
PUT {{baseUrl}}/api/admin/grade-configuration
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "grades": [
    { "gradeLevelId": 1, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 2, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 3, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 4, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 5, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 6, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 7, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 8, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 9, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 10, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 11, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 12, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 13, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 14, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 15, "isActive": true, "sectionIds": [1, 2] },
    { "gradeLevelId": 16, "isActive": true, "sectionIds": [1, 2] }
  ]
}

### Create a school tenant with its initial administrator
POST {{baseUrl}}/api/admin/schools
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "schoolName": "Example School",
  "schoolCode": "EXAMPLE-SCHOOL",
  "contactEmail": "contact@example.edu",
  "contactPhone": "+1-555-0100",
  "address": "1 Example Street",
  "adminFullName": "School Administrator",
  "adminEmail": "admin@example.edu",
  "adminTemporaryPassword": "Replace-With-A-Strong-Temporary-Password"
}

### Create a tenant as a SuperAdmin
POST {{baseUrl}}/api/superadmin/schools
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "schoolName": "Example School",
  "schoolCode": "EXAMPLE-SCHOOL",
  "contactEmail": "contact@example.edu",
  "contactPhone": "+1-555-0100",
  "address": "1 Example Street",
  "adminFullName": "School Administrator",
  "adminEmail": "admin@example.edu",
  "adminTemporaryPassword": "Replace-With-A-Strong-Temporary-Password"
}

### Load the created school details (SuperAdmin only)
GET {{baseUrl}}/api/superadmin/schools/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{accessToken}}
