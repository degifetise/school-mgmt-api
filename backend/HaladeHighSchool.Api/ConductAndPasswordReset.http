@baseUrl = http://localhost:5006
@adminToken = replace-with-admin-access-token
@teacherToken = replace-with-teacher-access-token
@studentToken = replace-with-student-access-token
@studentId = 1
@conductLogId = 1
@passwordResetRequestId = 1

### Request an administrator-approved password reset (same response for unknown emails)
POST {{baseUrl}}/api/auth/forgot-password-request
Content-Type: application/json

{
  "email": "student@example.edu"
}

### List pending password reset requests
GET {{baseUrl}}/api/admin/password-reset-requests/pending
Authorization: Bearer {{adminToken}}

### Approve a password reset and send a temporary password
POST {{baseUrl}}/api/admin/approve-password-reset/{{passwordResetRequestId}}
Authorization: Bearer {{adminToken}}

### Reject a password reset request
POST {{baseUrl}}/api/admin/reject-password-reset/{{passwordResetRequestId}}
Authorization: Bearer {{adminToken}}

### Record conduct for a student
POST {{baseUrl}}/api/conduct/logs
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "studentId": {{studentId}},
  "type": "Merit",
  "title": "Excellent teamwork",
  "description": "Helped classmates complete the science activity.",
  "incidentDate": "2026-10-28T00:00:00Z",
  "isVisibleToStudent": true,
  "isVisibleToParent": true
}

### View a student's conduct history
GET {{baseUrl}}/api/conduct/student/{{studentId}}?type=All
Authorization: Bearer {{adminToken}}

### View the signed-in student's own status
GET {{baseUrl}}/api/conduct/my-status
Authorization: Bearer {{studentToken}}

### Delete a conduct record (administrator or authoring teacher)
DELETE {{baseUrl}}/api/conduct/logs/{{conductLogId}}
Authorization: Bearer {{adminToken}}
