@baseUrl = http://localhost:5006
@schoolSlug = example-high-school


GET {{baseUrl}}/api/public/schools/slug/{{schoolSlug}}

### Submit a student registration to this school only
POST {{baseUrl}}/api/public/schools/slug/{{schoolSlug}}/register
Content-Type: multipart/form-data; boundary=HaladeRegistrationBoundary

--HaladeRegistrationBoundary
Content-Disposition: form-data; name="requestedRole"

Student
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="fullName"

Alex Example
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="email"

parent@example.com
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="phoneNumber"

+1 555 0100
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="gradeLevelId"

1
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="sectionId"

1
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="photo"; filename="profile.jpg"
Content-Type: image/jpeg

< ./profile.jpg
--HaladeRegistrationBoundary--

### Submit a teacher registration (use an existing JPG or PNG file)
POST {{baseUrl}}/api/public/schools/slug/{{schoolSlug}}/register
Content-Type: multipart/form-data; boundary=HaladeRegistrationBoundary

--HaladeRegistrationBoundary
Content-Disposition: form-data; name="requestedRole"

Teacher
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="fullName"

Taylor Example
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="email"

taylor@example.com
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="phoneNumber"

+1 555 0101
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="departmentSubject"

Mathematics
--HaladeRegistrationBoundary
Content-Disposition: form-data; name="photo"; filename="profile.jpg"
Content-Type: image/jpeg

< ./profile.jpg
--HaladeRegistrationBoundary--
